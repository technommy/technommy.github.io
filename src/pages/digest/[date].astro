---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DigestCard from '../../components/DigestCard.astro';
import GroundworkCTA from '../../components/GroundworkCTA.astro';

export async function getStaticPaths() {
  const digestsDir = path.resolve(process.cwd(), 'src/data/digests');
  if (!fs.existsSync(digestsDir)) {
    return [];
  }

  const files = fs.readdirSync(digestsDir).filter((f) => f.endsWith('.json'));
  return files.map((file) => {
    const dateStr = file.replace('.json', '');
    const content = JSON.parse(fs.readFileSync(path.join(digestsDir, file), 'utf-8'));
    return {
      params: { date: dateStr },
      props: {
        dateStr,
        digest: content,
      },
    };
  });
}

const { dateStr, digest } = Astro.props;
const siteUrl = 'https://technommy.github.io';
const pageUrl = `${siteUrl}/digest/${dateStr}/`;

const customSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: siteUrl,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Daily Research Digest',
        item: `${siteUrl}/`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: `Digest Archive: ${dateStr}`,
        item: pageUrl,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: `Applied Systems & Compute Research Digest — ${dateStr}`,
    description: `Daily curated technical digest covering ${digest.count} peer-reviewed preprints, developer discussions, and hardware architecture benchmarks for ${dateStr}.`,
    url: pageUrl,
    datePublished: dateStr,
    publisher: {
      '@type': 'Organization',
      name: 'Technommy Engineering Laboratory',
      url: siteUrl,
    },
  },
];
---

<BaseLayout
  title={`Research Digest Archive: ${dateStr} | Technommy Labs`}
  description={`Archived edition of Technommy Daily Research Digest for ${dateStr}. Ingested preprints, compute benchmarks, and system trade-offs.`}
  canonical={pageUrl}
  customSchema={customSchema}
  ogType="article"
>
  <div class="breadcrumbs">
    <a href="/">Home</a> <span>/</span> <span>Digest Archive</span> <span>/</span> <span>{dateStr}</span>
  </div>

  <header class="archive-header">
    <div class="badge">HISTORICAL ARCHIVE</div>
    <h1>Daily Research Digest: {dateStr}</h1>
    <p class="subtitle">
      Immutable archive edition published on {digest.updated_at}. Synthesizing {digest.count} authoritative papers and systems discussions across distributed architecture, inference hardware, and compute economics.
    </p>
  </header>

  <div class="digest-grid">
    {digest.items.map((item: any) => (
      <DigestCard
        title={item.title}
        link={item.link}
        summary={item.summary}
        source={item.source}
        category={item.category}
        published_at={item.published_at}
        domain={item.domain}
        signal_score={item.signal_score}
      />
    ))}
  </div>

  <GroundworkCTA
    title="Model Your Team's On-Premises vs Cloud GPU Compute Economics"
    description="Calculate exact break-even amortization, token-per-second memory bandwidth ceilings, and kWh energy draw for local Apple Silicon and RTX workstations against AWS/Lambda instances."
    buttonText="Open Interactive TCO Calculator ↗"
    calculatorUrl="https://gworky.com/tools/mac-studio-vs-cloud-gpu-tco-calculator"
  />

  <div class="back-nav">
    <a href="/" class="back-link">← Return to Latest Live Digest</a>
  </div>
</BaseLayout>

<style>
  .breadcrumbs {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .archive-header {
    margin-bottom: 3rem;
  }
  .badge {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--accent);
    background: var(--accent-glow);
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    margin-bottom: 1rem;
    border: 1px solid rgba(56, 189, 248, 0.25);
  }
  h1 {
    font-size: 2.3rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 0.75rem;
    color: #ffffff;
    letter-spacing: -0.02em;
  }
  .subtitle {
    color: var(--text-sub);
    font-size: 1.05rem;
    max-width: 760px;
    line-height: 1.6;
  }
  .digest-grid {
    margin-bottom: 3rem;
  }
  .back-nav {
    margin-top: 2rem;
    text-align: center;
  }
  .back-link {
    display: inline-block;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    transition: all 0.15s ease;
  }
  .back-link:hover {
    border-color: var(--accent);
    background: var(--accent-glow);
  }
</style>
