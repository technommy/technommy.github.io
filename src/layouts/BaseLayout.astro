---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogType?: string;
}

const {
  title,
  description = "Technommy — Empirical research on compute economics, local AI inference hardware, and systems engineering optimization.",
  canonical = Astro.url.href,
  ogType = "website"
} = Astro.props;

const siteUrl = "https://technommy.github.io";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- OpenGraph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Technommy" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <!-- Structured Data JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Technommy",
    "url": siteUrl,
    "description": description,
    "publisher": {
      "@type": "Organization",
      "name": "Technommy Engineering Laboratory",
      "url": siteUrl
    }
  })} />

  <style is:global>
    :root {
      --bg: #0b0f19;
      --card-bg: #111827;
      --card-hover: #162032;
      --border: #1f293d;
      --border-accent: #334155;
      --text-main: #f3f4f6;
      --text-muted: #9ca3af;
      --text-sub: #cbd5e1;
      --accent: #38bdf8;
      --accent-hover: #7dd3fc;
      --accent-glow: rgba(56, 189, 248, 0.12);
      --green: #34d399;
      --green-bg: rgba(52, 211, 153, 0.12);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: var(--bg);
      color: var(--text-main);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .wrapper {
      max-width: 960px;
      margin: 0 auto;
      padding: 0 1.5rem;
      width: 100%;
    }
    a {
      color: var(--accent);
      text-decoration: none;
      transition: color 0.15s ease;
    }
    a:hover {
      color: var(--accent-hover);
    }
    header.site-header {
      border-bottom: 1px solid var(--border);
      padding: 1.25rem 0;
      position: sticky;
      top: 0;
      background: rgba(11, 15, 25, 0.88);
      backdrop-filter: blur(12px);
      z-index: 50;
    }
    .nav-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .logo {
      font-weight: 700;
      font-size: 1.25rem;
      letter-spacing: -0.02em;
      color: #ffffff;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .logo-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.7rem;
      background: var(--accent-glow);
      color: var(--accent);
      padding: 0.15rem 0.45rem;
      border-radius: 4px;
      border: 1px solid rgba(56, 189, 248, 0.25);
    }
    nav.nav-links {
      display: flex;
      gap: 1.5rem;
      font-size: 0.9rem;
      align-items: center;
    }
    nav.nav-links a {
      color: var(--text-muted);
      font-weight: 500;
    }
    nav.nav-links a:hover, nav.nav-links a.active {
      color: #ffffff;
    }
    .nav-cta {
      background: var(--accent);
      color: #0b0f19 !important;
      padding: 0.35rem 0.85rem;
      border-radius: 6px;
      font-weight: 600;
      font-size: 0.85rem;
    }
    .nav-cta:hover {
      background: var(--accent-hover);
    }
    main {
      flex: 1;
      padding: 3rem 0;
    }
    footer.site-footer {
      border-top: 1px solid var(--border);
      padding: 2.5rem 0;
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-top: auto;
    }
    .footer-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="wrapper nav-inner">
      <a href="/" class="logo">
        <span>Technommy</span>
        <span class="logo-badge">LABS</span>
      </a>
      <nav class="nav-links">
        <a href="/">Daily Digest</a>
        <a href="/compare/">Compare Matrix</a>
        <a href="https://gworky.com/tech" target="_blank" rel="noopener" class="nav-cta">Groundwork Tech ↗</a>
      </nav>
    </div>
  </header>

  <main>
    <div class="wrapper">
      <slot />
    </div>
  </main>

  <footer class="site-footer">
    <div class="wrapper footer-inner">
      <div>
        <strong>Technommy Engineering Laboratory</strong> • Empirical Compute Economics & Systems Architecture.
      </div>
      <div>
        Syndicated via <a href="https://gworky.com" target="_blank" rel="noopener">Groundwork Media</a> • Hosted on GitHub Pages (DA 96).
      </div>
    </div>
  </footer>
</body>
</html>
