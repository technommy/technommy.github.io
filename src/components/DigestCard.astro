---
interface Props {
  title: string;
  link: string;
  summary: string;
  source: string;
  category: string;
  published_at: string;
  domain: string;
}

const { title, link, summary, source, category, published_at, domain } = Astro.props;
---

<article class="digest-card">
  <div class="card-meta">
    <span class="source-tag">{source}</span>
    <span class="category-tag">{category}</span>
    <span class="date">{published_at}</span>
  </div>
  <h3 class="card-title">
    <a href={link} target="_blank" rel="noopener noreferrer">
      {title}
    </a>
  </h3>
  <p class="card-summary">{summary}</p>
  <div class="card-footer">
    <span class="domain">via {domain}</span>
    <a href={link} target="_blank" rel="noopener noreferrer" class="read-link">
      Read Original Paper ↗
    </a>
  </div>
</article>

<style>
  .digest-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem;
    margin-bottom: 1.25rem;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .digest-card:hover {
    border-color: var(--border-accent);
    transform: translateY(-2px);
  }
  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    font-size: 0.75rem;
    flex-wrap: wrap;
  }
  .source-tag {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 500;
    color: var(--accent);
    background: var(--accent-glow);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }
  .category-tag {
    color: var(--text-sub);
    background: rgba(255, 255, 255, 0.05);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }
  .date {
    color: var(--text-muted);
  }
  .card-title {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 0.6rem;
  }
  .card-title a {
    color: #ffffff;
  }
  .card-title a:hover {
    color: var(--accent);
  }
  .card-summary {
    color: var(--text-sub);
    font-size: 0.95rem;
    line-height: 1.55;
    margin-bottom: 1rem;
  }
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    color: var(--text-muted);
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    padding-top: 0.75rem;
  }
  .read-link {
    font-weight: 500;
  }
</style>
